# Copy to backend/.env and adjust. Never commit the real .env.

# Core
SECRET_KEY=dev-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset to use local SQLite; set this to use the docker Postgres.
# DATABASE_URL=postgres://gjuvault:gjuvault@localhost:5432/gjuvault

# GJU account rules
GJU_EMAIL_DOMAINS=gju.edu.jo

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Vault transit (GJU credential encryption) ---
# Running the whole stack via `docker compose up`? The backend container
# bootstraps this itself on startup -- nothing to set here.
#
# Running backend on the host against docker's db/vault/minio instead?
# `docker compose up db vault minio minio-init`, then run
# scripts/vault_dev_setup.sh once to enable the transit engine, create the
# key, and print an encrypt token and a decrypt token. Set ONLY ONE of the
# two tokens below per deployment -- see backend/accounts/vault_transit.py
# for why.
VAULT_ADDR=http://localhost:8200
VAULT_TRANSIT_KEY_NAME=gju-credentials
# VAULT_ENCRYPT_TOKEN=          # the web app's .env
# VAULT_DECRYPT_TOKEN=          # the offline sync worker's .env only

# --- Production only ---
# CSRF_TRUSTED_ORIGINS=https://gjuvault.com,https://api.gjuvault.com
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=GJU Vault <no-reply@gjuvault.com>

# --- Object storage (S3-compatible) ---
# MinIO on the homelab now, Cloudflare R2 / AWS S3 later. Nothing but these
# values changes between them.
#
# S3_ENDPOINT_URL is what *Django* uses to reach the bucket; it can be a LAN
# address or a docker service name. S3_PUBLIC_ENDPOINT_URL is what the
# *browser* uses, and it is what presigned URLs are signed against -- set it
# whenever the two differ, or signatures will not verify. Leave it unset when
# they are the same.
S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=https://s3.yourhomelab.example
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gju-vault-dev
# S3_REGION=us-east-1

# Presigned URL lifetimes (seconds) and the upload size cap (bytes).
# S3_UPLOAD_URL_TTL=900
# S3_DOWNLOAD_URL_TTL=300
# MAX_UPLOAD_BYTES=52428800
# UPLOAD_THROTTLE_RATE=30/day

# --- Homelab MinIO notes ---
# 1. Create a dedicated MinIO user for the app rather than using the root
#    credentials, with a policy limited to s3:GetObject / PutObject /
#    DeleteObject / ListBucket on this one bucket.
# 2. Put MinIO behind HTTPS (a reverse proxy with a real certificate). Browsers
#    block a plain-http PUT from an https page, so an http endpoint only works
#    while the whole site is local.
# 3. The browser PUTs directly to MinIO from a different origin, so the bucket
#    needs a CORS rule allowing PUT and GET from the site origin, exposing the
#    ETag header.
