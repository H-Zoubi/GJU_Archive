# Copy to backend/.env and adjust. Never commit the real .env.

# Core
SECRET_KEY=dev-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset to use local SQLite; set this to use the docker Postgres.
# DATABASE_URL=postgres://gjuvault:gjuvault@localhost:5432/gjuvault

# GJU account rules
GJU_EMAIL_DOMAINS=gju.edu.jo

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Production only ---
# CSRF_TRUSTED_ORIGINS=https://gjuvault.com,https://api.gjuvault.com
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=GJU Vault <no-reply@gjuvault.com>

# --- Object storage (MinIO in dev) ---
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=gju-vault-dev
